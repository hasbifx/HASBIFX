{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "message": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "avatar_color": {
      "type": "string",
      "default": "#10b981"
    }
  },
  "required": [
    "message"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}