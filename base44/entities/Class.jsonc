{
  "name": "Class",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "Pemula",
        "Menengah",
        "Lanjutan"
      ],
      "default": "Pemula"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "icon": {
      "type": "string",
      "default": "BookOpen"
    }
  },
  "required": [
    "title",
    "order"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}