{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "lesson_id": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "lesson_id",
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}